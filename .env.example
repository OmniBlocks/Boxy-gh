# ---------------------------------------------------------------------------
# Probot / GitHub App (required)
# ---------------------------------------------------------------------------
# From https://github.com/settings/apps/<your-app>
APP_ID=
# The full contents of the app's .pem private key. Keep it on one line and
# escape the newlines as \n, or wrap the whole value in quotes.
PRIVATE_KEY=
WEBHOOK_SECRET=

# Local development only: proxy webhooks through smee.io
# WEBHOOK_PROXY_URL=https://smee.io/your-channel

# Optional Probot settings
# PORT=3000
# LOG_LEVEL=info
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Model providers
# Providers without a key are skipped in the fallback chain, so you only need
# keys for the ones you actually want to use.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Second Google key used by the "-backup" providers to spread rate limits
GEMINI_BACKUP_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HYPERBOLIC_API_KEY=
SILICONFLOW_API_KEY=
NOVITA_API_KEY=
# Pollinations falls back to the literal "any" when unset
POLLINATIONS_API_KEY=

# Comma-separated provider names or types (e.g. "google,groq" or
# "gemini-3.5-flash,novita"). ENABLED acts as an allowlist when set;
# DISABLED is always applied as a denylist. Leave blank to use all providers.
BOXY_ENABLED_PROVIDERS=
BOXY_DISABLED_PROVIDERS=

# ---------------------------------------------------------------------------
# Tools (src/tools.js, src/ai.js)
# ---------------------------------------------------------------------------
# Tavily web search
TAVILY_API_KEY=
# Firecrawl: used for web search and as the fallback for fetch_url when a page
# is JS-rendered or blocks a plain request. Leave blank to skip it entirely.
FIRECRAWL_API_KEY=
# Point at a self-hosted Firecrawl (e.g. http://localhost:3002). /v2 is appended
# unless the URL already ends in a version. Setting this alone is enough to
# enable Firecrawl, since self-hosted instances usually run without auth.
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# Search provider order, comma-separated: firecrawl, tavily.
# Defaults to "firecrawl,tavily"; providers without a key are skipped.
# ImgHippo image uploads
IMGHIPPO_API_KEY=

# ---------------------------------------------------------------------------
# Remote sandbox over SSH (src/container.js)
# Required for running commands / cloning repos in a container.
# ---------------------------------------------------------------------------
BOXY_SSH_HOST=
BOXY_SSH_USER=
BOXY_SSH_PASSWORD=
# Defaults to 22
BOXY_SSH_PORT=22
# Defaults to /home/$BOXY_SSH_USER/boxy-workspace
BOXY_REMOTE_WORKSPACE=

# ---------------------------------------------------------------------------
# Bot behaviour (src/index.js, src/permissions.js)
# ---------------------------------------------------------------------------
# Handle the bot answers to. Defaults to @OmniBlocks/boxy
BOXY_MENTION_HANDLE=@OmniBlocks/boxy

# Minimum author role per capability: public | community | trusted
BOXY_MIN_ROLE_COMMANDS=community
BOXY_MIN_ROLE_TASKS=community
BOXY_MIN_ROLE_ISSUES=community
BOXY_MIN_ROLE_CREDENTIALS=trusted
